/* Ana pencere stili */
QMainWindow {
    background-color: #f5f6fa;
}

/* Grup kutuları */
QGroupBox {
    border: 1px solid #d8dbe6;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
    color: #2f3640;
}

/* Form kontrolleri */
QLineEdit, QDateEdit, QComboBox, QSpinBox, QTextEdit {
    border: 1px solid #cfd3df;
    border-radius: 4px;
    padding: 4px 6px;
    background: #ffffff;
}

QPushButton {
    background-color: #3f51b5;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #32408f;
}

QPushButton:disabled {
    background-color: #aab0c5;
}
